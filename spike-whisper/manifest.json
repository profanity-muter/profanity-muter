{
  "manifest_version": 3,
  "name": "Whisper Spike",
  "version": "0.0.1",
  "description": "Spike: on-device Whisper transcription in an MV3 offscreen document.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["offscreen", "storage"],
  "host_permissions": ["https://huggingface.co/*", "https://*.huggingface.co/*"],
  "action": {
    "default_title": "Whisper Spike"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/test.wav", "dist/*.js", "dist/*.wasm", "dist/*.mjs"],
      "matches": ["chrome-extension://*/*"]
    }
  ]
}
